{# templates/base.html.twig - Layout maitre eStock #}

{% set user = current_user %}
{% set role = current_role %}
{% set app_nom = param_app_name() %}
{% set initiale = (user.nom|default('U')|trim)|slice(0,1)|upper %}

{# ---- Theme ---- #}
{% set theme_palettes = {
    'indigo':  ['#6366f1','#4f46e5','#eef2ff'],
    'emerald': ['#10b981','#059669','#ecfdf5'],
    'sky':     ['#0ea5e9','#0284c7','#e0f2fe'],
    'rose':    ['#f43f5e','#e11d48','#fff1f2'],
    'amber':   ['#f59e0b','#d97706','#fffbeb']
} %}
{% set theme_colour = param('theme_couleur', 'indigo') %}
{% set theme_vars = theme_palettes[theme_colour]|default(theme_palettes.indigo) %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token|e('html_attr') }}">
    <link rel="manifest" href="{{ base_url }}manifest.php">
    <meta name="theme-color" content="#4f46e5">
    <title>{{ titre_page|default(app_nom) }} · {{ app_nom }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ base_url }}assets/css/style.css" rel="stylesheet">
    {# CDN fallback : si le CDN est indisponible, utiliser les fichiers locaux #}
    <script nonce="{{ csp_nonce_val }}">
    (function(){
        function fallbackCDN(cdnUrl, localUrl, integrity) {
            var link = document.querySelector('link[href="' + cdnUrl + '"]');
            if (link) {
                link.onerror = function() {
                    link.href = localUrl;
                };
            }
        }
        fallbackCDN(
            'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css',
            '{{ base_url }}vendor/bootstrap.min.css'
        );
    })();
    </script>
    <link rel="icon" type="image/x-icon" href="{{ base_url }}assets/images/logo-eStock.ico">
    <style nonce="{{ csp_nonce_val }}">
        :root {
            --brand: {{ theme_vars[0]|escape('css') }};
            --brand-2: {{ theme_vars[1]|escape('css') }};
            --brand-soft: {{ theme_vars[2]|escape('css') }};
        }
    </style>
    {% block head_extra %}{% endblock %}
</head>
<body>

{% if is_logged_in %}
<div class="app-shell">

    <!-- ============ SIDEBAR (source unique : includes/sidebar.php via render_sidebar_html) ============ -->
    {{ render_sidebar_html() }}

    <!-- ============ CONTENU ============ -->
    <div class="app-main">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="burger" id="burger" aria-label="Menu"><i class="bi bi-list"></i></button>
                <div>
                    <h1>{{ titre_page|default(app_nom) }}</h1>
                    {% if sous_titre is defined and sous_titre %}
                        <div class="crumb">{{ sous_titre }}</div>
                    {% endif %}
                </div>
            </div>
            <div class="d-none d-md-flex align-items-center gap-2">
                <span id="connectionBadge"></span>
                {% if can_bill %}
                    <a href="caisse.php" class="btn btn-success btn-sm"><i class="bi bi-cart-check"></i> Caisse</a>
                {% endif %}
                {% if can_manage_stock %}
                    <a href="suggestions_achat.php"
                       class="btn btn-sm {{ (nb_alertes_topbar|default(0)) > 0 ? 'btn-outline-warning' : 'btn-outline-secondary' }}"
                       title="Alertes stock">
                        <i class="bi bi-bell"></i>
                        {% if (nb_alertes_topbar|default(0)) > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ nb_alertes_topbar }}
                            </span>
                        {% endif %}
                    </a>
                {% endif %}
                {% if peut('stock_consulter') and (nb_alertes_peremption|default(0)) > 0 %}
                    <a href="peremptions.php"
                       class="btn btn-sm btn-outline-danger position-relative"
                       title="Alertes péremption">
                        <i class="bi bi-calendar-week"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            {{ nb_alertes_peremption }}
                        </span>
                    </a>
                {% endif %}
                <a href="tableau_bord.php" class="btn btn-outline-secondary btn-sm"><i class="bi bi-house-door"></i></a>
            </div>
            <form method="POST" action="auth/logout.php" class="m-0 d-flex align-items-center">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="btn btn-outline-danger btn-sm" title="Se déconnecter">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-md-inline ms-1">Déconnexion</span>
                </button>
            </form>
        </header>

        <main class="app-content" id="appMain">

{% else %}
<main class="app-content">
{% endif %}

        {% block body %}{% endblock %}

        </main><!-- /.app-content -->
    </div><!-- /.app-main -->
</div><!-- /.app-shell -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
{# CDN fallback JS : si le CDN est indisponible, charger les fichiers locaux #}
<script nonce="{{ csp_nonce_val }}">
(function(){
    if (typeof bootstrap === 'undefined') {
        var s = document.createElement('script');
        s.src = '{{ base_url }}vendor/bootstrap.bundle.min.js';
        document.head.appendChild(s);
    }
    if (typeof JsBarcode === 'undefined') {
        var s2 = document.createElement('script');
        s2.src = '{{ base_url }}vendor/JsBarcode.all.min.js';
        document.head.appendChild(s2);
    }
})();
</script>
    <script nonce="{{ csp_nonce_val }}">window.BASE_URL = {{ base_url|json_encode|raw }};</script>
<script nonce="{{ csp_nonce_val }}" src="{{ base_url }}assets/js/app.js"></script>
<script nonce="{{ csp_nonce_val }}">
if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('{{ base_url }}sw.js').catch(function(){});
}
</script>
{% block scripts_extra %}{% endblock %}

{# ---- Toast container pour les messages flash ---- #}
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1090;" id="flashToastContainer"></div>
<script nonce="{{ csp_nonce_val }}">
(function(){
    var msgs = {{ flash_messages|json_encode|raw }};
    if (!msgs || !msgs.length) return;
    var icons = {success:'check-circle-fill', danger:'exclamation-triangle-fill', warning:'exclamation-triangle-fill', info:'info-circle-fill'};
    var container = document.getElementById('flashToastContainer');
    msgs.forEach(function(f){
        var toastEl = document.createElement('div');
        toastEl.className = 'toast align-items-center text-bg-' + (f.type === 'danger' ? 'danger' : f.type) + ' border-0';
        toastEl.setAttribute('role','alert');
        toastEl.setAttribute('aria-live','assertive');
        toastEl.setAttribute('aria-atomic','true');

        var flex = document.createElement('div');
        flex.className = 'd-flex';

        var body = document.createElement('div');
        body.className = 'toast-body';

        var icon = document.createElement('i');
        icon.className = 'bi bi-' + (icons[f.type]||'bell') + ' me-2';
        body.appendChild(icon);

        // Utiliser textContent au lieu de innerHTML pour éviter le XSS
        var text = document.createTextNode(f.message);
        body.appendChild(text);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn-close btn-close-white me-2 m-auto';
        btn.setAttribute('data-bs-dismiss', 'toast');
        btn.setAttribute('aria-label', 'Close');

        flex.appendChild(body);
        flex.appendChild(btn);
        toastEl.appendChild(flex);
        container.appendChild(toastEl);

        var toast = new bootstrap.Toast(toastEl, {delay: 5000});
        toast.show();
        toastEl.addEventListener('hidden.bs.toast', function(){ toastEl.remove(); });
    });
})();
</script>
</body>
</html>
